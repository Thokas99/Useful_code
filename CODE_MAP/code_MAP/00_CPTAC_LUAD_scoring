# from RPKM to TPM
```{r}

rna_fpkm <- vroom(
  "input/data_mrna_seq_rpkm.txt",
  show_col_types = FALSE
) |>
  select(-Entrez_Gene_Id) |>
  filter(
    !is.na(Hugo_Symbol),
    !Hugo_Symbol %in% c("", "NA")
  ) |>
  mutate(across(-Hugo_Symbol, as.numeric)) |>
  drop_na() |>

  # Input is log2(FPKM), so return to the linear scale
  mutate(across(-Hugo_Symbol, ~ 2^.x)) |>

  # For duplicated symbols, retain the row with highest median expression
  mutate(
    median_fpkm = apply(
      pick(-Hugo_Symbol),
      1,
      median
    )
  ) |>
  slice_max(
    median_fpkm,
    by = Hugo_Symbol,
    n = 1,
    with_ties = FALSE
  ) |>
  select(-median_fpkm) |>
  column_to_rownames("Hugo_Symbol") |>
  as.matrix()

# Linear FPKM → TPM
rna_tpm <- sweep(
  rna_fpkm,
  MARGIN = 2,
  STATS = colSums(rna_fpkm),
  FUN = "/"
) * 1e6

# TPM → log2(TPM + 1)
rna_logtpm <- log2(rna_tpm + 1)

# Validation
stopifnot(
  all(rna_fpkm >= 0),
  all(rna_tpm >= 0),
  all(is.finite(rna_logtpm)),
  all(abs(colSums(rna_tpm) - 1e6) < 1e-6)
)

summary(colSums(rna_tpm))
range(rna_logtpm)

