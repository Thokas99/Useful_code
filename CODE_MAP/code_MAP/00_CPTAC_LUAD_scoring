```{r}

set.seed(1234)

# ============================================================
# Helpers
# ============================================================

scale_numeric <- function(x) {
  as.numeric(scale(x))
}

class_from_z <- function(x) {
  case_when(
    x < -1  ~ "Not-C1-like",
    x <= 0  ~ "Not-C1-intermediate",
    x <= 1  ~ "C1-intermediate",
    x > 1   ~ "C1-like",
    TRUE    ~ NA_character_
  )
}

c1_group_levels <- c(
  "Not-C1-like",
  "Not-C1-intermediate",
  "C1-intermediate",
  "C1-like"
)

# Choose the normalized expression matrix used for scoring
expr_mat <- as.matrix(rna_logtpm)

# ============================================================
# 1. Load and prepare the C1 signature
# ============================================================

c1_genes <- vroom(
  "input/C1_Core_signature.csv",
  show_col_types = FALSE
) |>
  transmute(
    gene = as.character(gene),
    direction = toupper(C1_Core_direction)
  ) |>
  filter(
    !is.na(gene),
    gene != "",
    direction %in% c("UP", "DOWN")
  ) |>
  distinct(gene, direction)

c1_up <- c1_genes |>
  filter(direction == "UP") |>
  pull(gene) |>
  intersect(rownames(expr_mat))

c1_down <- c1_genes |>
  filter(direction == "DOWN") |>
  pull(gene) |>
  intersect(rownames(expr_mat))

stopifnot(
  length(c1_up) > 0,
  length(c1_down) > 0
)

# Optional signature coverage table
c1_gene_coverage <- tibble(
  direction = c("UP", "DOWN"),
  requested = c(
    sum(c1_genes$direction == "UP"),
    sum(c1_genes$direction == "DOWN")
  ),
  found = c(
    length(c1_up),
    length(c1_down)
  )
)

# ============================================================
# 2. singscore
# ============================================================

singscore_tbl <- expr_mat |>
  rankGenes() |>
  simpleScore(
    upSet = c1_up,
    downSet = c1_down
  ) |>
  as.data.frame() |>
  rownames_to_column("sample") |>
  transmute(
    sample,
    singscore = scale_numeric(TotalScore)
  )

# ============================================================
# 3. GSVA
# ============================================================

gsva_sets <- list(
  C1_UP = c1_up,
  C1_DOWN = c1_down
)

gsva_mat <- gsva(
  gsvaParam(
    exprData = expr_mat,
    geneSets = gsva_sets,
    kcdf = "Gaussian"
  )
)

gsva_tbl <- gsva_mat |>
  as.data.frame() |>
  rownames_to_column("direction") |>
  pivot_longer(
    cols = -direction,
    names_to = "sample",
    values_to = "value"
  ) |>
  pivot_wider(
    names_from = direction,
    values_from = value
  ) |>
  transmute(
    sample,
    gsva = scale_numeric(C1_UP - C1_DOWN)
  )

# ============================================================
# 4. Final consensus score and class
# ============================================================

c1_score_tbl <- singscore_tbl |>
  inner_join(gsva_tbl, by = "sample") |>
  mutate(
    C1_Core = scale_numeric(
      rowMeans(
        cbind(singscore, gsva),
        na.rm = TRUE
      )
    ),
    C1_class = factor(
      class_from_z(C1_Core),
      levels = c1_group_levels
    ),
    sample = sample |>
      sub("_S\\d+$", "", x = _) |>
      sub("WTST\\d*$", "", x = _)
  ) |>
  select(
    sample,
    C1_Core,
    C1_class
  ) |>
  arrange(C1_class, desc(C1_Core))

c1_score_tbl

c1_score_tbl |>
  count(C1_class, .drop = FALSE)

