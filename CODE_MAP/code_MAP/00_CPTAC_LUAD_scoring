# Score all Hallmark signatures with singscore
## Rank expression data once

## 5. Prepare Expression Data for Scoring

This section prepares the expression matrix for single-sample pathway scoring. The matrix is already logCPM, so the goal here is not normalization, but making sure the object has the expected orientation and gene identifiers for the scoring functions.

```{r}

rank_data <- singscore::rankGenes(rna_logtpm)

```

## Score every signature:

## 6. ssGSEA Hallmark Scores

This section computes ssGSEA scores for the Hallmark signatures. ssGSEA produces a pathway activity score for every sample and every Hallmark gene set, allowing pathway-level comparisons across the organoid samples.

```{r}

# ============================================================
# Score all Hallmark signatures
# ============================================================

hallmark_singscore_long <- purrr::imap_dfr(
  hallmark_signatures_found,
  \(signature_genes, signature_name) {

    score_result <- singscore::simpleScore(
      rankData = rank_data,
      upSet = signature_genes
    )

    score_result |>
      as.data.frame() |>
      tibble::rownames_to_column("sample") |>
      tibble::as_tibble() |>
      dplyr::transmute(
        sample,
        signature = signature_name,
        score = TotalScore
      )
  }
)

hallmark_singscore_long

hallmark_singscore <- hallmark_singscore_long |>
  tidyr::pivot_wider(
    names_from = signature,
    values_from = score
  ) |>
  dplyr::arrange(match(sample, colnames(rna_logtpm)))

hallmark_singscore

write_tsv(
  hallmark_singscore,
  "output/tables/hallmark_singscore_scores.tsv"
)

```


## 7. Hallmark Score Heatmap

This section visualizes Hallmark activity across samples. Scores are transformed to row-wise Z-scores for display so that each pathway is centered and scaled across samples; this highlights relative high and low activity patterns without changing the original score table used for statistical testing.

```{r}

# ============================================================
# Hallmark singscore heatmap annotated by C1 score and class
# ============================================================

# Signature score matrix: signatures × samples
score_mat <- hallmark_singscore |>
  column_to_rownames("sample") |>
  as.matrix() |>
  t()

# Remove HALLMARK_ prefix for cleaner row labels
rownames(score_mat) <- stringr::str_remove(
  rownames(score_mat),
  "^HALLMARK_"
)

# ------------------------------------------------------------
# Match Hallmark samples with C1 metadata
# ------------------------------------------------------------

common_samples <- intersect(
  colnames(score_mat),
  c1_score_tbl$sample
)

if (length(common_samples) < 3) {
  stop(
    "Fewer than three shared samples were found between ",
    "hallmark_singscore and c1_score_tbl."
  )
}

score_mat <- score_mat[
  ,
  common_samples,
  drop = FALSE
]

c1_heatmap_metadata <- c1_score_tbl |>
  dplyr::select(
    sample,
    C1_Core,
    C1_class
  ) |>
  dplyr::filter(sample %in% common_samples) |>
  dplyr::arrange(match(sample, common_samples)) |>
  tibble::column_to_rownames("sample")

stopifnot(
  identical(
    colnames(score_mat),
    rownames(c1_heatmap_metadata)
  )
)

# ------------------------------------------------------------
# Row-wise Z-score for visualization
# ------------------------------------------------------------

score_mat_z <- t(
  scale(
    t(score_mat)
  )
)

# Remove signatures with zero variance or invalid values
score_mat_z <- score_mat_z[
  apply(
    score_mat_z,
    1,
    function(x) all(is.finite(x))
  ),
  ,
  drop = FALSE
]

# ------------------------------------------------------------
# Order samples by C1 core score
# ------------------------------------------------------------

sample_order <- order(
  c1_heatmap_metadata$C1_Core,
  na.last = TRUE
)

# ------------------------------------------------------------
# C1 annotation colours
# ------------------------------------------------------------

c1_group_cols <- c(
  "Not-C1-like"         = "#2166AC",
  "Not-C1-intermediate" = "#92C5DE",
  "C1-intermediate"     = "#F4A582",
  "C1-like"             = "#B2182B"
)

# Symmetric continuous scale around zero
c1_limit <- max(
  abs(c1_heatmap_metadata$C1_Core),
  na.rm = TRUE
)

c1_score_col_fun <- circlize::colorRamp2(
  c(-c1_limit, 0, c1_limit),
  c("#2166AC", "white", "#B2182B")
)

# ------------------------------------------------------------
# Column annotations
# ------------------------------------------------------------

column_ha <- HeatmapAnnotation(
  `C1 core score` = c1_heatmap_metadata$C1_Core,
  `C1 group` = c1_heatmap_metadata$C1_class,

  col = list(
    `C1 core score` = c1_score_col_fun,
    `C1 group` = c1_group_cols
  ),

  annotation_name_side = "left",
  na_col = "#E5E5E5",

  annotation_legend_param = list(
    `C1 core score` = list(
      title = "C1 core score",
      at = c(-c1_limit, 0, c1_limit),
      labels = round(
        c(-c1_limit, 0, c1_limit),
        1
      )
    ),
    `C1 group` = list(
      title = "C1 group"
    )
  )
)

# ------------------------------------------------------------
# Viridis heatmap colour scale
# ------------------------------------------------------------

# Use the 95th percentile to reduce the effect of extreme Z-scores

z_limit <- unname(
  quantile(
    abs(score_mat_z),
    probs = 0.95,
    na.rm = TRUE
  )
)

if (!is.finite(z_limit) || z_limit == 0) {
  z_limit <- max(
    abs(score_mat_z),
    na.rm = TRUE
  )
}

score_col_fun <- circlize::colorRamp2(
  seq(
    -z_limit,
    z_limit,
    length.out = 5
  ),
  viridisLite::viridis(
    5,
    option = "D"
  )
)
# ------------------------------------------------------------
# Construct heatmap
# ------------------------------------------------------------

hallmark_heatmap <- Heatmap(
  score_mat_z,

  name = "Row Z-score",
  col = score_col_fun,

  top_annotation = column_ha,

  # Order samples from low to high C1 score
  column_order = sample_order,

  cluster_rows = TRUE,
  cluster_columns = FALSE,

  show_row_names = TRUE,
  show_column_names = TRUE,

  row_names_gp = grid::gpar(fontsize = 7),
  column_names_gp = grid::gpar(fontsize = 8),
  column_names_rot = 90,

  column_title = "Hallmark activity ordered by C1 core score",
  row_title = "Hallmark signatures",

  border = TRUE,
  use_raster = TRUE,
  raster_quality = 3,

  heatmap_legend_param = list(
    title = "Row\nZ-score",
    at = c(-z_limit, 0, z_limit),
    labels = round(
      c(-z_limit, 0, z_limit),
      1
    )
  )
)

# ------------------------------------------------------------
# Draw heatmap
# ------------------------------------------------------------

draw(
  hallmark_heatmap,
  heatmap_legend_side = "right",
  annotation_legend_side = "right",
  merge_legends = TRUE
)

# ------------------------------------------------------------
# Save heatmap
# ------------------------------------------------------------

dir.create(
  "output/figures",
  recursive = TRUE,
  showWarnings = FALSE
)

png(
  "output/figures/hallmark_heatmap_C1.png",
  width = 4000,
  height = 2600,
  res = 200
)

draw(
  hallmark_heatmap,
